package tachyon:mesh@1.1.0;

// This file is the single source of truth for all Tachyon Mesh WIT interfaces.
// Do NOT fork worlds or create `-with-X` variants. Per-deployment import
// authorization is layered on top by the host at link time and in runtime host
// closures — the guest binary is unchanged. See `core-host/src/host_core/scoping/`
// for the host-side implementation of the authorization layer.

interface handler {
    type headers = list<tuple<string, string>>;

    record request {
        method: string,
        uri: string,
        headers: headers,
        body: list<u8>,
        trailers: headers,
    }

    record response {
        status: u16,
        headers: headers,
        body: list<u8>,
        trailers: headers,
    }

    handle-request: func(req: request) -> response;
}

interface udp-handler {
    record datagram {
        target-ip: string,
        target-port: u16,
        payload: list<u8>,
    }

    handle-packet: func(source-ip: string, source-port: u16, payload: list<u8>) -> list<datagram>;
}

interface websocket {
    variant frame {
        text(string),
        binary(list<u8>),
        ping(list<u8>),
        pong(list<u8>),
        close,
    }

    resource connection {
        send: func(frame: frame) -> result<_, string>;
        receive: func() -> option<frame>;
    }
}

interface custom-metrics {
    enum metric-type {
        counter,
        gauge,
        histogram,
    }

    record metric {
        name: string,
        value: f64,
        kind: metric-type,
        tags: list<tuple<string, string>>,
    }

    /// Submits a domain-specific metric to the host observability plane.
    push: func(data: metric) -> result<_, string>;
}

interface telemetry-reader {
    record metrics-snapshot {
        total-requests: u64,
        completed-requests: u64,
        error-requests: u64,
        active-requests: u32,
        cpu-pressure: u8,
        ram-pressure: u8,
        active-instances: u32,
        allocated-memory-pages: u32,
        capability-mask: u64,
        capabilities: list<string>,
        active-l4-relays: u32,
        l4-throughput-bytes-per-sec: u64,
        l4-load-score: u8,
        advertise-ip: string,
        cpu-rt-load: u32,
        cpu-standard-load: u32,
        cpu-batch-load: u32,
        gpu-rt-load: u32,
        gpu-standard-load: u32,
        gpu-batch-load: u32,
        npu-rt-load: u32,
        npu-standard-load: u32,
        npu-batch-load: u32,
        tpu-rt-load: u32,
        tpu-standard-load: u32,
        tpu-batch-load: u32,
        hot-models: list<string>,
        dropped-events: u64,
        last-status: u16,
        total-duration-us: u64,
        total-wasm-duration-us: u64,
        total-host-overhead-us: u64,
    }

    get-metrics: func() -> metrics-snapshot;
}

interface scaling-metrics {
    get-pending-queue-size: func(route-path: string) -> u32;
}

interface vector {
    type index-name = string;
    type embedding = list<f32>;

    record index-spec {
        name: index-name,
        dim: u32,
        m: u32,
        ef-construction: u32,
    }

    record document {
        id: string,
        embedding: embedding,
        payload: option<list<u8>>,
    }

    record search-match {
        id: string,
        score: f32,
        payload: option<list<u8>>,
    }

    create-index: func(spec: index-spec) -> result<_, string>;
    upsert: func(name: index-name, docs: list<document>) -> result<_, string>;
    search: func(name: index-name, query: embedding, k: u32) -> result<list<search-match>, string>;
    remove: func(name: index-name, id: string) -> result<bool, string>;
}

interface training {
    type rank = u32;
    type step-budget = u32;

    record dataset-handle {
        volume-alias: string,
        path: string,
        split: option<string>,
    }

    record training-job {
        base-model: string,
        dataset: dataset-handle,
        rank: rank,
        max-steps: step-budget,
        seed: option<u64>,
    }

    record job-id {
        value: string,
    }

    variant job-status {
        queued,
        running(tuple<u32, u32>),
        completed(string),
        failed(string),
    }

    submit-training-job: func(job: training-job) -> result<job-id, string>;
    get-training-status: func(id: job-id) -> result<job-status, string>;
}

interface storage-broker {
    enum write-mode {
        overwrite,
        append,
    }

    enqueue-write: func(path: string, mode: write-mode, body: list<u8>) -> result<_, string>;
    snapshot-volume: func(volume-id: string, source-path: string, snapshot-path: string) -> result<_, string>;
    restore-volume: func(volume-id: string, snapshot-path: string, destination-path: string) -> result<_, string>;
}

interface model-events {
    record model-file {
        path: string,
        size-bytes: u64,
        sha256: string,
    }

    record model-uploaded {
        alias: string,
        engine: string,
        model-path: string,
        files: list<model-file>,
    }

    publish-model-uploaded: func(event: model-uploaded) -> result<_, string>;
}

interface outbound-http {
    type headers = list<tuple<string, string>>;

    record response {
        status: u16,
        headers: headers,
        body: list<u8>,
    }

    send-request: func(method: string, url: string, headers: headers, body: list<u8>) -> result<response, string>;
}

interface outbox-store {
    record outbox-event {
        id: string,
        content-type: string,
        body: list<u8>,
    }

    claim-events: func(db-url: string, table: string, max-events: u32) -> result<list<outbox-event>, string>;
    ack-event: func(db-url: string, table: string, id: string) -> result<_, string>;
}

interface bridge-controller {
    record bridge-config {
        client-a-addr: string,
        client-b-addr: string,
        timeout-seconds: u32,
    }

    record bridge-endpoints {
        bridge-id: string,
        ip: string,
        port-a: u16,
        port-b: u16,
    }

    create-bridge: func(config: bridge-config) -> result<bridge-endpoints, string>;
    destroy-bridge: func(bridge-id: string) -> result<_, string>;
}

interface routing-control {
    update-target: func(route-path: string, destination: string) -> result<_, string>;
}

interface secrets-vault {
    enum error {
        not-found,
        permission-denied,
        vault-disabled,
    }

    get-secret: func(name: string) -> result<string, error>;
}

interface graph {
    record edge {
        subject: string,
        predicate: string,
        object: string,
        properties: string,
    }

    resource workspace-graph {
        // Host validates `name` against deployment scopes at construction; subsequent
        // methods do not re-check (handle-bound invariant).
        constructor(name: string);
        add-edges: func(edges: list<edge>) -> result<_, string>;
        delete-edges: func(edges: list<edge>) -> result<_, string>;
        traverse: func(subject: string, predicate: string, depth: u32) -> result<list<string>, string>;
    }
}

interface kv-partition {
    resource table {
        // Host validates `name` against deployment scopes at construction; subsequent
        // methods do not re-check (handle-bound invariant).
        constructor(name: string);
        get: func(key: string) -> result<list<u8>, string>;
        set: func(key: string, value: list<u8>) -> result<_, string>;
        compare-and-set: func(key: string, expected: option<list<u8>>, value: list<u8>) -> result<bool, string>;
        delete: func(key: string) -> result<_, string>;
        batch-set: func(entries: list<tuple<string, list<u8>>>) -> result<_, string>;
        get-range: func(
            start-key: string,
            end-key: string,
            limit: u32,
            offset: u32,
        ) -> result<list<tuple<string, list<u8>>>, string>;
    }
}

/// Generic incremental body-flush transport. A guest acquires the
/// `streaming-response` handle via `get-streaming-response`, commits the
/// HTTP status and headers with `begin`, then flushes body bytes with
/// `write`. Each `write` is forwarded to the client immediately; the stream
/// terminates when the handle is dropped. Only available when the host
/// execution path was set up for streaming (i.e. the request included
/// `Accept: text/event-stream`). Non-streaming requests receive an error
/// from `get-streaming-response` and fall back to the buffered
/// `handler::response` return value.
interface response-body {
    resource streaming-response {
        /// Commit the response status and headers; the HTTP layer starts
        /// sending them to the client immediately. Must be called before
        /// any `write` call. Calling it more than once is an error.
        begin: func(status: u16, headers: list<tuple<string, string>>) -> result<_, string>;
        /// Flush a response body chunk to the client immediately.
        write: func(chunk: list<u8>) -> result<_, string>;
    }

    /// Obtain the streaming-response sink for this execution context.
    /// Returns an error when the host did not set up a streaming context for
    /// this request (no streaming slot pre-allocated).
    get-streaming-response: func() -> result<streaming-response, string>;
}

world faas-guest {
    import bridge-controller;
    import secrets-vault;
    import vector;
    import training;
    import kv-partition;
    import graph;
    import custom-metrics;
    import outbound-http;
    import response-body;
    export handler;
}

world udp-faas-guest {
    import secrets-vault;
    export udp-handler;
}

world websocket-faas-guest {
    import secrets-vault;
    import websocket;
    import outbound-http;
    use websocket.{connection};
    export on-connect: func(connection: borrow<connection>);
}

world system-faas-guest {
    import bridge-controller;
    import telemetry-reader;
    import custom-metrics;
    import scaling-metrics;
    import storage-broker;
    import model-events;
    import outbound-http;
    export handler;
}

world background-system-faas {
    import scaling-metrics;
    import telemetry-reader;
    import custom-metrics;
    import outbound-http;
    import outbox-store;
    import routing-control;
    export on-tick: func();
}

world control-plane-faas {
    import telemetry-reader;
    import custom-metrics;
    import scaling-metrics;
    import outbound-http;
    import routing-control;
    import kv-partition;
    export handler;
    export on-tick: func();
}
