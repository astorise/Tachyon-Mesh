package tachyon:ai-config@1.1.0;

interface config-ai {
    enum engine-backend {
        cpu,
        cuda,
        metal,
        auto-detect,
    }

    /// `tensor-parallelism`/`pipeline-parallelism`/`expert-parallelism` are
    /// executable, not configuration-only. The runtime now wires this
    /// `hardware-strategy` into model loading: `candle_llm_runtime::try_load`
    /// reads it, validates the plan against discovered hardware, and selects
    /// the matching engine (see
    /// `openspec/changes/2026-06-22-wire-model-parallel-runtime-dispatch`).
    /// Status by mode: `tensor-parallelism` runs the full autoregressive
    /// decode loop; `pipeline-parallelism` is loaded and prefill-correct but
    /// its decode loop is a disclosed follow-up (generation returns a typed
    /// error until then); `expert-parallelism` is validated and placed but
    /// rejected at load until a full MoE checkpoint loader lands (only the
    /// verified per-expert primitive exists today). Real GPU execution,
    /// multi-GPU VRAM telemetry, and the NCCL all-reduce require the
    /// `candle-cuda` build and are exercised on the CUDA CI lane.
    enum gpu-distribution {
        single,
        tensor-parallelism,
        pipeline-parallelism,
        expert-parallelism,
    }

    enum sharing-mode {
        isolated,
        lora-multiplexing,
    }

    record engine-config {
        backend: engine-backend,
        quantization: option<string>,
        max-context-window: u32,
        flash-attention: bool,
    }

    record hardware-strategy {
        multi-gpu: bool,
        distribution-mode: gpu-distribution,
        /// Device IDs participating in a tensor/pipeline/expert-parallel plan.
        /// Empty/ignored when `distribution-mode` is `single`.
        device-ids: list<u32>,
        /// For pipeline-parallelism: inclusive (start, end) layer-index range
        /// per device, indexed by position in `device-ids`.
        stage-layer-ranges: list<tuple<u32, u32>>,
        /// For expert-parallelism: (expert-id, device-ids index) placement pairs.
        expert-device-map: list<tuple<u32, u32>>,
        /// Bounded number of micro-batches kept in flight across pipeline
        /// stages. Ignored outside `pipeline-parallelism`.
        pipeline-depth: u32,
        /// Request block-paged KV-cache attention. Tachyon accepts this
        /// declarative knob only when its runtime has wired Candle's paged
        /// flash-attn API to a block allocator and per-sequence block table.
        paged-attention: bool,
        /// Request CUDA Graph capture/replay for the steady-state decode step.
        /// Tachyon rejects this until its GPU decode loop has fixed shapes,
        /// stable device buffers, and a direct `candle-core` CudaGraph path.
        cuda-graph-decode: bool,
        /// Request the optional Candle FlashInfer-style decode-attention
        /// backend. Tachyon rejects this until the model decode path is wired
        /// to `candle-flashinfer-kernels`.
        flashinfer-attention: bool,
        /// Optional prefill chunk size in tokens. Absent uses Tachyon's
        /// default (8192 tokens), `some(0)` disables chunked prefill.
        prefill-chunk-tokens: option<u32>,
        /// Optional local model directory for speculative decoding. When set,
        /// core-host loads this draft model beside the target model and uses a
        /// greedy propose/verify loop; unsupported request modes fall back to
        /// the target-only decode path.
        speculative-draft-model-path: string,
        /// Maximum draft tokens proposed before target verification. `0` uses
        /// the runtime default.
        speculative-draft-tokens: u32,
    }

    record lora-adapter {
        name: string,
        asset-ref: string,
        routing-header-key: string,
        routing-header-value: string,
    }

    record sharing-strategy {
        mode: sharing-mode,
        base-model-memory-lock: bool,
        adapters: list<lora-adapter>,
    }

    record model-deployment {
        name: string,
        asset-ref: string,
        engine: engine-config,
        strategy: hardware-strategy,
        sharing: sharing-strategy,
    }

    record ai-configuration {
        deployments: list<model-deployment>,
    }

    validate-ai-config: func(config: ai-configuration) -> result<_, string>;
    get-ai-config: func() -> result<ai-configuration, string>;
    apply-model-deployment: func(deployment: model-deployment) -> result<_, string>;
}

world ai-orchestration-config {
    export config-ai;
}
