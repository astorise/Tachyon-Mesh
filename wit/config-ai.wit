package tachyon:ai-config@1.1.0;

interface config-ai {
    enum placement-backend {
        cpu,
        cuda,
        metal,
        npu,
        tpu,
        auto-detect,
    }

    record placement-strategy {
        backend: placement-backend,
        device-ids: list<u32>,
        memory-limit-mb: option<u64>,
    }

    record component-deployment {
        name: string,
        component-ref: string,
        artifact-ref: string,
        placement: placement-strategy,
    }

    record ai-configuration {
        deployments: list<component-deployment>,
    }

    validate-ai-config: func(config: ai-configuration) -> result<_, string>;
    get-ai-config: func() -> result<ai-configuration, string>;
    apply-component-deployment: func(deployment: component-deployment) -> result<_, string>;
}

world ai-orchestration-config {
    export config-ai;
}
