package tachyon:accelerator@1.1.0;

interface cpu {
    /// Token counts for one generation, in the shape OpenAI's `usage` object
    /// reports them. Both are exact counts from the tokenizer and the decode
    /// loop — never a re-tokenization of the output text, which would differ
    /// from the sequence the model actually produced.
    record token-usage {
        prompt-tokens: u32,
        completion-tokens: u32,
    }

    /// A handle to an in-progress streaming generation. The caller pulls decoded
    /// text fragments with `next` until it returns `none`, which signals that
    /// generation is complete. Dropping the handle abandons the generation.
    resource token-stream {
        /// Block until the next decoded text fragment is available. Returns
        /// `none` once generation finishes, or an error string if it failed.
        next: func() -> result<option<string>, string>;
        /// Token counts for this generation, available only after `next` has
        /// returned `none`: the totals are not known until decoding ends, and
        /// the last fragment has gone down the stream by then. Returns `none`
        /// while the generation is still running, and for backends that cannot
        /// count tokens (a mock, a vendor runner returning text over a pipe) —
        /// so a caller omits `usage` rather than publishing zeros as if they
        /// were measured.
        usage: func() -> option<token-usage>;
    }

    /// A completed buffered generation: the decoded text, and the token counts
    /// when the backend could measure them.
    record generation {
        text: string,
        usage: option<token-usage>,
    }

    load-model: func(name: string) -> result<u32, string>;
    compute: func(model-id: u32, prompt: string) -> result<string, string>;
    /// `compute`, plus the token counts. Kept as a separate function rather
    /// than changing `compute`'s return type, so every existing caller that
    /// only wants the text is untouched.
    compute-detailed: func(model-id: u32, prompt: string) -> result<generation, string>;
    /// Compute a dense L2-normalized embedding for one input string with a
    /// model previously loaded by `load-model`.
    embed: func(model-id: u32, input: string) -> result<list<f32>, string>;
    /// Begin a streaming generation for a previously loaded model. The returned
    /// `token-stream` yields decoded text fragments as the host produces them,
    /// giving the caller real time-to-first-token instead of a buffered result.
    /// The concatenation of every fragment equals the buffered `compute` output.
    compute-stream: func(model-id: u32, prompt: string) -> result<token-stream, string>;
}
