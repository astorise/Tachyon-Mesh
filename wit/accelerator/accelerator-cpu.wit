package tachyon:accelerator@4.0.0;

// 4.0.0 replaces the historical model/generation ABI with an opaque
// Component invocation ABI. Protocol details such as OpenAI chat messages,
// tool calls, usage objects, finish reasons, and embeddings belong to the
// guest, the selected Component, or Magnetar, not to Tachyon core.

interface cpu {
    record invocation-error {
        message: string,
        upstream-status: option<u16>,
        invalid-request: bool,
    }

    record invocation-result {
        payload: list<u8>,
        metadata: list<tuple<string, string>>,
    }

    variant stream-event {
        payload(list<u8>),
        metadata(list<tuple<string, string>>),
    }

    resource byte-stream {
        next: func() -> result<option<stream-event>, invocation-error>;
        metadata: func() -> list<tuple<string, string>>;
    }

    load-component: func(alias: string) -> result<u32, string>;
    invoke: func(component-id: u32, payload: list<u8>) -> result<invocation-result, invocation-error>;
    invoke-stream: func(component-id: u32, payload: list<u8>) -> result<byte-stream, invocation-error>;
}
