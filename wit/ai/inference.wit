package tachyon:mesh@2.0.0;

/// Public local-inference contract after the Magnetar cutover.
///
/// Tachyon carries request bytes, routing, QoS, trust, and transport concerns.
/// Model format parsing, tokenizer/chat-template rendering, execution planning,
/// multi-device behavior, and Provider execution belong to Magnetar.
interface inference {
    record inference-request {
        /// Foundation model alias as declared in the route's `models`.
        model: string,
        /// UTF-8 JSON request envelope or plain prompt bytes for the selected model.
        prompt: list<u8>,
        /// Maximum tokens to generate.
        max-tokens: u32,
        /// Sampling temperature (0.0-2.0).
        temperature: f32,
    }

    record inference-response {
        output: list<u8>,
        prompt-tokens: u32,
        completion-tokens: u32,
        /// Total accelerator-side fuel consumed (host stamps this for metering).
        fuel-consumed: u64,
    }

    /// Run a single local inference call through the active Magnetar-backed
    /// runtime selected by Tachyon placement policy.
    infer: func(req: inference-request) -> result<inference-response, string>;
}

world inference-host {
    export inference;
}
