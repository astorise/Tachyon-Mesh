package tachyon:mesh@1.1.0;

/// Inference interface that accepts an optional per-call LoRA adapter. The default
/// path (no adapter) matches the existing inference behaviour exactly.
interface inference {
    record inference-request {
        /// Foundation model alias as declared in the route's `models`.
        model: string,
        /// Tokenised or text-mode prompt; encoding is up to the model.
        prompt: list<u8>,
        /// Optional tenant-specific LoRA adapter to overlay on top of the foundation
        /// model for this single call. When `none`, the foundation model is used as-is.
        adapter-id: option<string>,
        /// Maximum tokens to generate.
        max-tokens: u32,
        /// Sampling temperature (0.0-2.0).
        temperature: f32,
    }

    record inference-response {
        output: list<u8>,
        prompt-tokens: u32,
        completion-tokens: u32,
        /// Total accelerator-side fuel consumed (host stamps this for metering).
        fuel-consumed: u64,
    }

    /// Controls how model weights and the KV-cache are placed relative to VRAM.
    enum memory-profile {
        /// Default: load all weights to VRAM at startup. Maximum throughput; OOM
        /// risk proportional to model size.
        performance,
        /// Layer-wise streaming: keep only one transformer layer in VRAM at a time.
        /// Each layer is loaded from a memory-mapped `.safetensors` file on demand
        /// and dropped after its forward pass. The KV-Cache is paged to Host RAM
        /// after each layer, maintaining an O(1) VRAM footprint.
        layer-wise-streaming,
    }

    /// Per-call tuning knobs that override the model-level defaults.
    record inference-options {
        temperature: f32,
        max-tokens: u32,
        /// Selects the VRAM placement strategy for this call.
        profile: memory-profile,
    }

    /// Run a single inference call. The host honours `adapter-id` by hot-applying the
    /// adapter weights via Candle, then removing the overlay before returning.
    infer: func(req: inference-request) -> result<inference-response, string>;

    /// Run a call with explicit per-call options. Falls back to `infer` semantics
    /// when `options.profile` is `performance`.
    infer-with-options: func(req: inference-request, options: inference-options) -> result<inference-response, string>;
}

/// Zero-copy, handle-based layer manipulation contract for guests that orchestrate
/// model execution while native host memory owns tensor storage.
interface layer-execution {
    /// Opaque resource identifier representing a native tensor on the host.
    type tensor-handle = u32;
    type model-id = string;

    /// Instructs the host to slide the mmap window over specific safetensors blocks.
    load-layer: func(model: model-id, layer-index: u32) -> result<_, string>;

    /// Evicts the specified layer weights from memory/VRAM.
    unload-layer: func(model: model-id, layer-index: u32);

    /// Processes a vector of state pointers through the active layer weights.
    forward-layer: func(model: model-id, layer-index: u32, inputs: list<tensor-handle>) -> result<list<tensor-handle>, string>;

    /// Safely cleans up the tensor representation on the host side.
    drop-tensor: func(handle: tensor-handle);

    /// Samples the next token from a final logits tensor, constrained by an
    /// optional JSON Schema. When no schema is provided, the host samples from the
    /// unmasked logits.
    sample-constrained: func(logits: tensor-handle, json-schema: option<string>) -> result<u32, string>;
}

world inference-host {
    export inference;
    export layer-execution;
}
