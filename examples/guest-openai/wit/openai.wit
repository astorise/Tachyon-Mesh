package tachyon:openai@1.1.0;

/// guest-openai's world. It keeps the mesh surface it already used — the
/// `kv-partition` registry and the `handler` HTTP export — and adds the
/// CPU Component invocation import so `/ai/v1/chat/completions` can run real
/// inference through Tachyon's generic Component host on ai-inference builds.
/// Defining this in guest-openai's own package keeps the shared
/// `tachyon:mesh` `tachyon.wit` single-file and self-contained for every other
/// component.
world openai-faas-guest {
    import tachyon:mesh/kv-partition@2.0.0;
    import tachyon:accelerator/cpu@4.0.0;
    import tachyon:mesh/response-body@2.0.0;
    export tachyon:mesh/handler@2.0.0;
}
